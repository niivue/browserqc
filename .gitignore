# dependencies / build output
node_modules/
dist/

# Staged from node_modules by scripts/copy-brainchop.mjs on every dev/build run:
# build output, versioned by the @brainchop/mindgrab dependency, not source.
public/brainchop/

# npm is the single package authority — no bun lockfile
bun.lock

# OS / editor cruft
.DS_Store

# smoke-test failure screenshots
test/*.png

# transient audit review docs (audit_temp.md / audit_response.md) — not committed
audit_*.md

# local QC scratch data (subject scans / reference MRIQC reports) — never commit
qc/
